# 全部凭据均为占位符；复制为 .env 后在本机填写，不提交、不发送给构建器。
YOUJI_IMAGE=youji-cloud:local
YOUJI_API_PORT=8090
POSTGRES_DB=youji
POSTGRES_USER=youji
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
# 密码须与上方一致；URL 中的特殊字符须百分号编码，主机名必须为 postgres。
DATABASE_URL=postgres://youji:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@postgres:5432/youji
YOUJI_TOKEN_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
YOUJI_MAIL_TRANSPORT=smtp
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE_WITH_SMTP_ACCOUNT
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=REPLACE_WITH_VERIFIED_SENDER
# 仅 YOUJI_MAIL_TRANSPORT=http 时配置以下 HTTPS 适配器。
YOUJI_MAIL_URL=
YOUJI_MAIL_TOKEN=

# 公共地域根地址，不含桶名/路径；供客户端预签名地址使用。
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
# 可选，仅同地域内网可达时填写；不可把内网地址发送给桌面客户端。
OSS_INTERNAL_ENDPOINT=
# 所有存档位于此子目录，禁止空前缀；上线后不能随意改变。
OSS_PREFIX=games
OSS_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
OSS_REGION=cn-hangzhou
OSS_ACCESS_KEY_ID=REPLACE_WITH_ACCESS_KEY_ID
OSS_ACCESS_KEY_SECRET=REPLACE_WITH_ACCESS_KEY_SECRET
# 仅使用临时 STS 凭据时填写；长期凭据留空。
OSS_SECURITY_TOKEN=
USER_QUOTA_BYTES=10737418240
YOUJI_SAVE_WORKERS=2
# Compose 固定 YOUJI_SAVE_WORK_DIR=/var/lib/youji-worker，与 worker-temp 卷对应。
# 裸进程不设置该变量时使用系统临时目录。

# 仅启用 --profile proxy 时使用；默认 Compose 不启动 Caddy。
YOUJI_DOMAIN=cloud.example.invalid
ACME_EMAIL=admin@example.invalid
