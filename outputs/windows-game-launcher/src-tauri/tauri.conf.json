{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "游迹",
  "version": "0.2.8",
  "identifier": "dev.local.achievementlauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "create": false,
        "title": "游迹",
        "dragDropEnabled": true,
        "decorations": false,
        "shadow": true,
        "fullscreen": false,
        "maximized": true,
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/covers/*"
        ]
      },
      "csp": "default-src 'self' tauri: asset:; img-src 'self' asset: http: https: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/XboxLocalProbe.exe"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkzRkIyMjRCQjdCOTBFM0QKUldROURybTNTeUw3azE0YVZsMnAxNkNkVWFRdTJlOTdSYmdQZFZLcjUyT0J4OHBrcjgxbENKaisK",
      "endpoints": [
        "https://github.com/Libra11/windows-game-launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
